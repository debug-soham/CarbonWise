# Copy to .env and fill in. Never commit .env.

# Long random string used to sign login tokens. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on (Render sets this automatically)
PORT=5000

# MongoDB connection string. Required in production (MongoDB Atlas).
# Locally defaults to mongodb://127.0.0.1:27017/carbonwise
MONGODB_URI=

# Set to "production" on Render
NODE_ENV=development

# Optional, local only: DNS servers to use if your machine can't resolve
# mongodb+srv:// hosts ("querySrv ECONNREFUSED"). Leave unset on Render.
# DNS_SERVERS=8.8.8.8,1.1.1.1
